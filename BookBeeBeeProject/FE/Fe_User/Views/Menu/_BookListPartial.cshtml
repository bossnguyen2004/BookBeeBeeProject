@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Fe_User.Models.Book>
<div class="book-list-container">
@foreach (var book in Model)
{
    <div class="product-item">
        <div class="product @(book.Count > 0 ? "" : "out-of-stock")">
            <div class="product_image">
                <img src="@book.Image" alt="@book.Title">
            </div>

            @if (book.GiaThucTe < book.Price)
            {
                <div class="product_bubble product_bubble_right product_bubble_red">
                    <span>-@($"{(book.Price > 0 ? (int)Math.Round((1 - (book.GiaThucTe / book.Price)) * 100) : 0)}%")</span>

                </div>
            }

            <div class="product_info">
                <h6 class="product_name">
                    <a href="@Url.Action("ChiTiet", "Book", new { id = book.Id })">@book.Title</a>
                </h6>
                <div class="product_price">
                    @if (book.GiaThucTe < book.Price)
                    {
                        <span class="text-danger">@book.GiaThucTe.ToString("N0") VND</span>
                        <del class="text-muted">@book.Price.ToString("N0") VNĐ</del>
                    }
                    else
                    {
                        <span>@book.Price.ToString("N0") VNĐ</span>
                    }
                </div>
            </div>
        </div>
        <div class="red_button add_to_cart_button">
            <a href="@Url.Action("AddToCart", "Cart", new { id = book.Id })"
               class="@(book.Count > 0 ? "" : "disabled-link")">
                @(book.Count > 0 ? "Thêm vào giỏ" : "Hết hàng")
            </a>
        </div>
    </div>
}
</div>


<div class="row">
    <div class="col">
        @Html.PagedListPager(
                 Model,
                 page => Url.Action("SachMoi", new
                 {
                     page,
                     pageSize = Model.PageSize,
                     key = ViewBag.SearchKey,
                     isPartial = true 
                 }),
                 new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        }
                 )
    </div>
</div>
