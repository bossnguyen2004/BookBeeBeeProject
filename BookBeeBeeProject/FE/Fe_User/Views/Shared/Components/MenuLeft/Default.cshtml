@using X.PagedList
@using X.PagedList.Mvc.Core
@using System.Linq
@model IPagedList<Fe_User.Models.Tag>  

<ul class="sidebar_categories">
    @foreach (var item in Model)
    {
        <li>
            <a href="@Url.Action("MenuLeft", "Menu", new { tagId = item.Id })">
                <span><i class="fa fa-angle-double-right" aria-hidden="true"></i></span> @item.Name
            </a>
        </li>
    }
</ul>

