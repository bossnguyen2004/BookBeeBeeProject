@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model List<Fe_Admin.Models.Book>


@if (Model == null || !Model.Any())
{
    <p>Không có sản phẩm nào</p>
}
else
{
    @foreach (var item in Model)
    {
        <div class="col-6">
            <div class="card" style="width: 15rem;">
                <div class="card-body">
                    <h5 class="card-title"></h5>
                    <div style="height:200px;width:200px">
                        <img src="@Configuration.GetSection("BackendApi").Value@Url.Content(item?.Image ?? "")" class="card-img-top" alt="..." style="height:200px;width:200px">
                    </div>
                    <p class="card-text">s
                        <div style="height:30px">
                            <span>Tên Sách:@item?.Title</span>
                        </div>
                        @if (item?.GiaThucTe != null && item.GiaThucTe < item.Price)
                        {
                            <span style="color: black;">
                                Giá Gốc: <strike>@(string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.Price))</strike><br>
                            </span>
                            <strong style="color: red;">
                                Giá Sale: @(string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.GiaThucTe))
                            </strong>
                        }
                        else
                        {
                            <strong style="color: red;">
                                Giá: @(string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.Price))
                            </strong>
                        }
                       
                        <br>
                        <span>SL:</span>
                        @if (item?.Count != null && item.Count > 0)
                        {
                            <span id="@item.Id">@item.Count</span>
                        }
                        else if (item?.Count > 0)
                        {
                            <span id="@item.Id">@item.Count</span>
                        }
                        else
                        {
                            <span id="@item.Id">Hết Hàng</span>
                        }
                        <button onclick="add('@item?.Id')" class="btn btn-success" style="float: right;"> Add </button>
                    </p>
                </div>
            </div>
        </div>
@* 
        <div class="col-6">
            <div class="card product-card">
                <div class="card-body p-2">
                    <div class="image-container">
                        <img src="@Configuration.GetSection("BackendApi").Value@Url.Content(item?.Image ?? "")"
